# Скопируй этот файл в .env и вставь свои ключи.
# Файл .env НИКОГДА не загружай на GitHub.

# Токен бота от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=123456789:AAAA-вставь-сюда-свой-токен

# Ключ API из https://platform.claude.com (раздел API Keys)
ANTHROPIC_API_KEY=sk-ant-вставь-сюда-свой-ключ

# Ключ OpenAI — только чтобы бот понимал голосовые сообщения (https://platform.openai.com, раздел API keys).
# Можно не заполнять: тогда бот попросит написать вопрос текстом.
OPENAI_API_KEY=sk-вставь-сюда-ключ-openai

# Модель Claude: claude-haiku-4-5 (дешевле всего), claude-sonnet-5, claude-opus-5 (дороже и умнее)
CLAUDE_MODEL=claude-haiku-4-5

# Контакты приёмной комиссии AlmaU (перенос строки — \n)
ADMISSIONS_CONTACTS="admission@almau.edu.kz\nhttps://almau.edu.kz/ru/admission/"

# Сколько вопросов к ИИ один человек может задать за сутки
DAILY_AI_LIMIT=30

# Telegram ID администраторов через запятую (для команды /stats). Свой ID — команда /myid в боте
ADMIN_IDS=
